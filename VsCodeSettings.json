{
    "editor.fontFamily": "\"Liberation Mono\"",
    "editor.fontSize": 17,
    "terminal.integrated.fontFamily": "\"Liberation Mono\"",
    "terminal.integrated.fontSize": 17,
    "editor.lineHeight": 0,
    "workbench.startupEditor": "none",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.secondarySideBar.showLabels": false,
	"chat.agent.enabled": false,
    "editor.autoClosingBrackets": "always",
    "editor.autoClosingQuotes": "always",
    "editor.autoClosingDelete": "always",
    "editor.cursorBlinking": "blink",
	"editor.cursorStyle": "line",
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyleInactive": "line",
    "terminal.integrated.tabs.enableAnimation": false,
    "terminal.integrated.smoothScrolling": false,
    "editor.tabSize": 4,
    "editor.indentSize": "tabSize",
    "editor.autoIndent": "full",
    "editor.insertSpaces": false,
    "git.autofetch": true,
    "git.confirmSync": false,
    "editor.stickyScroll.enabled": false,
    "git.enableSmartCommit": true,
    "editor.autoClosingComments": "always",
    "editor.autoClosingOvertype": "always",
    "workbench.commandPalette.showAskInChat": false,
    "workbench.quickOpen.closeOnFocusLost": false,
    "chat.extensionUnification.enabled": false,
    "chat.tips.enabled": false,
    "chat.disableAIFeatures": true,
    "[search-result]": {
        "editor.lineNumbers": "on"
    },
    "editor.fontWeight": "normal",
    "editor.guides.bracketPairs": true,
    "editor.stickyScroll.maxLineCount": 1,
    "terminal.integrated.stickyScroll.enabled": false,
    "workbench.tree.enableStickyScroll": false,
    "editor.stickyScroll.scrollWithEditor": false,
    "terminal.integrated.stickyScroll.maxLineCount": 1,
    "explorer.compactFolders": false,
    "explorer.confirmDragAndDrop": false,
    "terminal.integrated.initialHint": false,
	"editor.hover.sticky": true,
	"editor.language.brackets": null,
	"explorer.enableDragAndDrop": true,
	"editor.renderRichScreenReaderContent": false,
	"autoHide.autoHideSideBar": false,
	"autoHide.panelDelay": 0,
    "autoHide.sideBarDelay": 0,
	"workbench.iconTheme": "material-icon-theme",
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "tailwindCSS.emmetCompletions": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.preferences.quoteStyle": "double",
    "js/ts.suggest.completeFunctionCalls": true,
    "js/ts.format.placeOpenBraceOnNewLineForControlBlocks": true,
    "js/ts.format.semicolons": "insert",
    "js/ts.format.placeOpenBraceOnNewLineForFunctions": true,
    "[markdown]": {
        "editor.wordWrap": "off"
    },
	"editor.detectIndentation": false,
	"editor.bracketPairColorization.independentColorPoolPerBracketType": false,
	"workbench.editor.titleScrollbarVisibility": "visible",
	"editor.acceptSuggestionOnEnter": "off",
	"editor.quickSuggestions": false,
	"workbench.settings.editor": "json",
	"editor.bracketPairColorization.enabled": true
}
