
{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [],
    "alwaysShowNotificationIcon": true,
    "centerOnLaunch": true,
    "copyFormatting": "none",
    "copyOnSelect": false,
    "showTabsFullscreen": false,
    "tabWidthMode": "equal",
    "minimizeToNotificationArea": false,

    "keybindings": 
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        }
    ],
    "newTabMenu": 
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles": 
    {


"defaults":
        {
            "colorScheme": "Love Is An Illusion",
            "cursorShape": "filledBox",
            "font":
            {
                "cellHeight": "1",
                "face": "Liberation Mono",
                "size": 13
            },
            "scrollbarState": "always"
        },

       
    },
    "schemes": [
        {
            "background": "#071307",
            "black": "#071307",
            "blue": "#90B080",
            "brightBlack": "#90B080",
            "brightBlue": "#90B080",
            "brightCyan": "#90B080",
            "brightGreen": "#90B080",
            "brightPurple": "#90B080",
            "brightRed": "#90B080",
            "brightWhite": "#90B080",
            "brightYellow": "#90B080",
            "cursorColor": "#40FF40",
            "cyan": "#90B080",
            "foreground": "#90B080",
            "green": "#90B080",
            "name": "Love Is An Illusion",
            "purple": "#90B080",
            "red": "#90B080",
            "selectionBackground": "#FFFFFF",
            "white": "#90B080",
            "yellow": "#90B080"
        }
    ],
    "themes": []
}
